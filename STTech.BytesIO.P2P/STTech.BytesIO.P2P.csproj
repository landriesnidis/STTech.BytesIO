<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<Version>3.4.0.0-alpha61110</Version>

		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
		<Company>KarFans Industrial Co., LTD (Shenzhen, China)</Company>
		<Authors>Guijie Lee</Authors>
		<Copyright>Copyright © 2019-2026 KarFans, All Rights Reserved.</Copyright>
		<PackageIcon>stdiag.png</PackageIcon>
		<Description>
			这是一个基于 Libp2p 协议的 .NET P2P 字节流通信库，作为 STTech.BytesIO 的扩展库，提供了统一的编程模型。
			支持 TCP/QUIC 传输、Noise/TLS 加密以及基于 Multiaddr 的点对点字节流传输。
			通过 PeerClient 和 BootstrapServer 核心类，实现点对点字节流通信。
		</Description>
		<PackageTags>STTech;BytesIO;P2P;Libp2p;PeerToPeer;Communication;Protocol;Async;Network</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<RepositoryUrl>https://github.com/landriesnidis/STTech.BytesIO</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://blog.csdn.net/lgj123xj/category_11758698.html</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\stdiag.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\STTech.BytesIO\STTech.BytesIO.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Nethermind.Libp2p" Version="1.0.0-preview.51" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="STTech.BytesIO.P2P.Tests" />
	</ItemGroup>

</Project>
