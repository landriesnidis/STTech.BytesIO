<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<TargetFrameworks>netstandard2.0;net8.0;net10.0;net8.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</TargetFrameworks>
	</PropertyGroup>
	<PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
		<TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Description>STTech.BytesIO 蓝牙扩展库，支持经典蓝牙 (Classic Bluetooth / RFCOMM / SPP) 与低功耗蓝牙 (BLE / GATT)，内置设备发现管理器 (BluetoothManager) 与统一的 BytesClient 通信模型。</Description>
		<PackageTags>STTech;BytesIO;Bluetooth;BLE;RFCOMM;SPP;GATT;Wireless;Communication;Protocol;Async;Industrial</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\STTech.BytesIO\STTech.BytesIO.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>STTech.BytesIO.Bluetooth.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
</Project>
