<Project>
	<!-- 为库项目统一注入 NuGet 包附带的 README.md 与图标（在 DefaultItems 之后执行；先 Remove 再 Include，兼顾交叉编译外层构建与单目标去重） -->
	<ItemGroup Condition="'$(_IsBytesIOLibrary)' == 'true'">
		<None Remove="README.md" Condition="Exists('README.md')" />
		<None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
		<None Include="..\stdiag.png" Pack="true" PackagePath="\" Condition="Exists('..\stdiag.png')" />
	</ItemGroup>
</Project>
